---
# === General ===
yake_install_method: docker
management_cluster_engine: kind

# proxy_env:
#   HTTP_PROXY: "http://proxy:8080"
#   http_proxy: "http://proxy:8080"
#   HTTPS_PROXY: "http://proxy:8080"
#   https_proxy: "http://proxy:8080"
#   NO_PROXY: "127.0.0.1,localhost"
#   no_proxy: "127.0.0.1,localhost"

# === clusterapi_cluster ===
clusterapi_cluster_kubernetes_version: "1.37.2"
# clusterapi_cluster_ntp_servers: [ntp.example.com]

clusterapi_cluster_openstack_auth_url: "https://keystone.example.com/v3"
clusterapi_cluster_openstack_application_credential_id: ""
clusterapi_cluster_openstack_application_credential_secret: ""
clusterapi_cluster_openstack_domain_name: "domain"
clusterapi_cluster_openstack_region_name: "region"
clusterapi_cluster_openstack_image_id: ""
# Optional safety check: fails the run if the image_id above no longer
# resolves to the image name you expect (e.g. after a stale/renamed reference).
clusterapi_cluster_openstack_image_name: ""
clusterapi_cluster_openstack_cacert: ""

clusterapi_cluster_control_plane_machine_flavor: "SCS-2V-4"
clusterapi_cluster_control_plane_machine_count: 3
clusterapi_cluster_worker_machine_flavor: "SCS-4V-8"
clusterapi_cluster_worker_machine_deployments:
  - name: md-0
    replicas: 3
    failure_domain: nova
    image_id: "{{ clusterapi_cluster_openstack_image_id }}"

clusterapi_cluster_root_volume_type: "default"
clusterapi_cluster_control_plane_root_volume_size: "20"
clusterapi_cluster_worker_root_volume_size: "20"
clusterapi_cluster_root_volume_availability_zone: nova

# Encrypt Secrets at rest in etcd (recommended). Back up /var/lib/yake/encryption-key.<name>.
clusterapi_cluster_secrets_encryption_enabled: true
# Highly available virtual garden (3 etcd members). Cannot be disabled again.
# gardener_operator_virtual_garden_high_availability: true

# gardener_operator_ntp_servers: "{{ clusterapi_cluster_ntp_servers }}"

# === gardener_operator: OpenStack credentials ===
gardener_operator_openstack_auth_url: "{{ clusterapi_cluster_openstack_auth_url }}"
gardener_operator_openstack_project_name: "project"
gardener_operator_openstack_domain_name: "{{ clusterapi_cluster_openstack_domain_name }}"
gardener_operator_openstack_region_name: "{{ clusterapi_cluster_openstack_region_name }}"
gardener_operator_openstack_application_credential_id: "{{ clusterapi_cluster_openstack_application_credential_id }}"
gardener_operator_openstack_application_credential_name: "creds"
gardener_operator_openstack_application_credential_secret: "{{ clusterapi_cluster_openstack_application_credential_secret }}"
gardener_operator_openstack_zones:
  - "nova"
gardener_operator_openstack_cacert: ""

gardener_operator_provider_openstack_storageclass_name: default
gardener_operator_provider_openstack_storageclass_type: default

# === gardener_operator: garden cluster ===
gardener_operator_garden_url: "botany.example.com"
gardener_operator_cluster_name: "garden"
gardener_operator_kubernetes_version: "{{ clusterapi_cluster_kubernetes_version }}"

gardener_operator_garden_cluster_admin_email: "demo@example.com"

# === gardener_operator: authentication (Dex) ===
gardener_operator_dex:
  dashboard_secret: ""
  # theme: dark
  static_passwords: []
  # - email: "admin@example.com"
  #   # bcrypt hash of the string "password": $(printf 'password' | htpasswd -BinC 10 admin | cut -d: -f2)
  #   hash: "$2a$10$2b2cU8CPhOTaGrs1HRQuAueS7JTT5ZHsHSzYiFPm1leZck7Mc8T4W"
  #   username: "admin"
  connectors: []
  # https://dexidp.io/docs/connectors/
  # - type: oidc
  #   id: keycloak
  #   name: Keycloak
  #   config:
  #     issuer: https://keycloak.example.com/realms/myrealm
  #     clientID: dex
  #     clientSecret: dex-secret
  #     redirectURI: https://identity.example.com/callback

# === gardener_operator: certificates ===
# Use "ca" to sign with a CA instead of ACME. Without a certificate and key, a
# self-signed CA is generated (see docs/configuration.md).
# gardener_operator_shoot_cert_service_issuer_type: ca
gardener_operator_shoot_cert_service_acme_email: "operations@example.com"
gardener_operator_shoot_cert_service_acme_server: "https://acme-staging-v02.api.letsencrypt.org/directory"

# === gardener_operator: cloud profiles ===
gardener_operator_cloudprofiles:
  - name: cloudprofile
    # When compute and volume zones differ (e.g. compute AZ1, volumes nova):
    # ignore_volume_az: true
    # root_disk_availability_zone: nova
    storageclasses:
      - name: default
        default: "true"
        type: default
        availability: nova
    floating_pools:
      - name: public
    loadbalancer_providers:
      - name: amphora
    keystone_urls:
      - region: "{{ clusterapi_cluster_openstack_region_name }}"
        url: "{{ clusterapi_cluster_openstack_auth_url }}"
    machine_images:
      - name: gardenlinux
        versions:
          - version: "2150.14.0"
            # classification: supported
            image: "Garden Linux 2150.14"
            # The Glance image ID is required: the machine-controller-manager cannot resolve the
            # name on clouds without the Nova image proxy. Replace the placeholder with the ID of
            # the image in your cloud (openstack image show "Garden Linux 2150.14" -c id).
            regions:
              - name: "{{ clusterapi_cluster_openstack_region_name }}"
                id: "REPLACE-WITH-GLANCE-IMAGE-ID"
    kubernetes_versions:
      - version: 1.37.2
        classification: supported
    machinetypes:
      - name: SCS-4V-8
        cpu: "4"
        gpu: "0"
        memory: 8Gi
        # Optional, not set by default. Default root disk size (boot volume).
        # Needed for SCS / disk-0 flavors, otherwise Nova rejects the server create
        # unless worker.volume.size is set. Do not set for flavors with an ephemeral
        # disk (an additional volume would be created). Optional: type, class
        storage:
          size: 50Gi
      - name: SCS-4V-16
        cpu: "4"
        gpu: "0"
        memory: 16Gi
    # Optional: flavor and image for `gardenctl ssh` bastions. Must exist in
    # machinetypes / machine_images of this profile. Use a small flavor WITH a root
    # disk (not a disk-0 flavor), the bastion has no boot volume.
    # bastion:
    #   machine_type: SCS-4V-8
    #   machine_image: gardenlinux
    #   machine_image_version: "2150.0.0"  # optional
    regions:
      - name: "{{ clusterapi_cluster_openstack_region_name }}"
        zones:
          - nova

# === gardener_operator: projects ===
gardener_operator_managed_seeds_project:
  name: seeds
  members:
    - email: "{{ gardener_operator_garden_cluster_admin_email }}"
      role: admin
      roles:
        - serviceaccountmanager

# gardener_operator_projects:
#   - name: team-a
#     members:
#       - email: "someone@example.com"
#         role: admin

# === gardener_operator: managed seeds ===
# gardener_operator_managed_seeds_registry_mirrors:
#   - upstream: docker.io
#     host: "https://registry.osism.cloud/v2/dockerhub"
#     override_path: true
#   - upstream: europe-docker.pkg.dev
#     host: "https://registry.osism.cloud/v2/pkg"
#     override_path: true
#   - upstream: gcr.io
#     host: "https://registry.osism.cloud/v2/gcr"
#     override_path: true
#   - upstream: ghcr.io
#     host: "https://registry.osism.cloud/v2/ghcr"
#     override_path: true
#   - upstream: quay.io
#     host: "https://registry.osism.cloud/v2/quay"
#     override_path: true
#   - upstream: registry.k8s.io
#     host: "https://registry.osism.cloud/v2/k8s"
#     override_path: true
gardener_operator_managed_seeds:
  - name: managed-seed-a
    cloudprofile_name: cloudprofile
    networking_type: cilium
    kubernetes_version: 1.37.2
    floating_pool_name: "public"
    openstack:
      auth_url: "{{ clusterapi_cluster_openstack_auth_url }}"
      project_name: "{{ gardener_operator_openstack_project_name }}"
      domain_name: "{{ gardener_operator_openstack_domain_name }}"
      region_name: "{{ clusterapi_cluster_openstack_region_name }}"
      application_credential_id: "{{ gardener_operator_openstack_application_credential_id }}"
      application_credential_name: "{{ gardener_operator_openstack_application_credential_name }}"
      application_credential_secret: "{{ gardener_operator_openstack_application_credential_secret }}"
    workers:
      - name: worker-4v8
        machinetype: SCS-4V-8
        image_name: gardenlinux
        image_version: 2150.14.0
        minimum: 3
        maximum: 15
        # Omit that variable to let Openstack choose the default volume-type
        #volume_type: default
        volume_size: 50Gi
        zones:
          - nova
    settings:
      # backup:
      #   provider: openstack
      #   region: "{{ clusterapi_cluster_openstack_region_name }}"
      #   bucket_name: bucket-seed-a
      #   credentials: {}
      excess_capacity_reservation: true

# === cleanup ===
cleanup_openstack_cloud: openstack
cleanup_clouds_file: /var/lib/yake/clouds.garden.yaml
