ARG ALPINE_VERSION=3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
FROM alpine:${ALPINE_VERSION}

COPY --chmod=0755 entrypoint.sh /entrypoint.sh
# renovate: datasource=github-releases depName=helm/helm
ARG VERSION=v4.3.2
ADD https://get.helm.sh/helm-${VERSION}-linux-amd64.tar.gz /helm.tar.gz
ADD https://get.helm.sh/helm-${VERSION}-linux-amd64.tar.gz.sha256sum /helm.tar.gz.sha256sum

ENV USER_NAME=helm
ENV USER_ID=1000
ENV GROUP_ID=1000

RUN echo "$(cut -d ' ' -f 1 /helm.tar.gz.sha256sum)  /helm.tar.gz" > /tmp/sha256sums \
    && sha256sum -c /tmp/sha256sums \
    && apk upgrade --no-cache --available \
    && apk add --no-cache \
      dumb-init \
      shadow \
    && addgroup -g ${GROUP_ID} ${USER_NAME} \
    && adduser -u ${USER_ID} -D -G ${USER_NAME} ${USER_NAME} \
    && mkdir /var/lib/yake \
    && chown -R ${USER_NAME}:${USER_NAME} /var/lib/yake \
    && tar -xzf /helm.tar.gz --strip-components=1 -C /usr/local/bin linux-amd64/helm \
    && rm /helm.tar.gz /helm.tar.gz.sha256sum /tmp/sha256sums

WORKDIR /var/lib/yake

VOLUME ["/var/lib/yake"]

ENTRYPOINT ["/entrypoint.sh"]
