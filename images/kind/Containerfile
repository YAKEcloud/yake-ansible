ARG ALPINE_VERSION=3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
FROM alpine:${ALPINE_VERSION}

COPY --chmod=0755 entrypoint.sh /entrypoint.sh
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
ARG VERSION=v0.33.0
ADD --chmod=0755 https://github.com/kubernetes-sigs/kind/releases/download/${VERSION}/kind-linux-amd64 /usr/bin/kind
ADD https://github.com/kubernetes-sigs/kind/releases/download/${VERSION}/kind-linux-amd64.sha256sum /tmp/kind.sha256sum

ENV USER_NAME=kind
ENV USER_ID=1000
ENV GROUP_ID=1000

ENV DOCKER_GROUP_NAME=docker
ENV DOCKER_GROUP_ID=988

RUN echo "$(cut -d ' ' -f 1 /tmp/kind.sha256sum)  /usr/bin/kind" > /tmp/sha256sums \
    && sha256sum -c /tmp/sha256sums \
    && rm /tmp/kind.sha256sum /tmp/sha256sums \
    && apk upgrade --no-cache --available \
    && apk add --no-cache \
      docker-cli \
      dumb-init \
      shadow \
    && addgroup -g ${GROUP_ID} ${USER_NAME} \
    && addgroup -g ${DOCKER_GROUP_ID} ${DOCKER_GROUP_NAME} \
    && adduser -u ${USER_ID} -D -G ${USER_NAME} ${USER_NAME} \
    && usermod -aG ${DOCKER_GROUP_NAME} ${USER_NAME} \
    && mkdir /var/lib/yake \
    && chown -R ${USER_NAME}:${USER_NAME} /var/lib/yake

WORKDIR /var/lib/yake

VOLUME ["/var/lib/yake"]

ENTRYPOINT ["/entrypoint.sh"]
