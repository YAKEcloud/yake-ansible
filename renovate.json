{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",
  "schedule": ["at any time"],
  "labels": ["renovate"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "separateMinorPatch": true,
  "commitBody": "Signed-off-by: Renovate Bot <bot@renovateapp.com>",
  "packageRules": [
    {
      "groupName": "kind and kindest/node",
      "description": "kind CLI and kindest/node must stay on compatible kubeadm config versions; bump together.",
      "matchDepNames": ["kubernetes-sigs/kind", "kindest/node"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles\\/clusterctl_install\\/defaults\\/main.yml$/",
        "/^roles\\/helm_install\\/defaults\\/main.yml$/",
        "/^roles\\/kubectl_install\\/defaults\\/main.yml$/",
        "/^group_vars\\/all\\.yml\\.example/",
        "/^roles\\/clusterapi_cluster\\/defaults\\/main.yml$/",
        "/^roles\\/gardener_operator\\/defaults\\/main.yml$/",
        "/^roles\\/management_cluster\\/defaults\\/main.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?)( registryUrl=(?<registryUrl>.*?))? depName=(?<depName>.*?)( extractVersion=(?<extractVersion>.*?))?\\n.*?(_tag|_version): '(?<currentValue>.*?)'"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-.*\\.yml/"],
      "matchStrings": [
        "version: (?<currentValue>.*?)  # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Giltfile.yaml/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n.*?version: '(?<currentValue>.*?)'"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images\\/clusterctl\\/Containerfile$/",
        "/^images\\/helm\\/Containerfile$/",
        "/^images\\/kind\\/Containerfile$/",
        "/^images\\/kubectl\\/Containerfile$/"
      ],
      "matchStrings": [
        "ARG VERSION=(?<currentValue>.*?)  # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n"
      ]
    }
  ]
}
