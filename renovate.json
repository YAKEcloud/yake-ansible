{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rebaseWhen": "behind-base-branch",
  "labels": ["renovate"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "separateMinorPatch": true,
  "commitBody": "Signed-off-by: Renovate Bot <bot@renovateapp.com>",
  "packageRules": [
    {
      "description": "Major updates need a human review.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Our own images are built from upstream releases that already passed minimumReleaseAge.",
      "matchPackageNames": ["ghcr.io/yakecloud/**"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "kind and kindest/node",
      "description": "kind CLI and kindest/node must stay on compatible kubeadm config versions; bump together.",
      "matchDepNames": ["kubernetes-sigs/kind", "kindest/node"]
    },
    {
      "description": "Cluster Kubernetes versions only, capped by .github/workflows/update-k8s-version-cap.yml. Tools (kubectl) are not capped.",
      "matchDepNames": ["kubernetes/kubernetes"],
      "matchFileNames": ["roles/**", "group_vars/**"],
      "allowedVersions": "<1.38.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles\\/[^/]+\\/defaults\\/main\\.yml$/",
        "/^group_vars\\/all\\.yml\\.example$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?)( registryUrl=(?<registryUrl>.*?))? depName=(?<depName>.*?)( extractVersion=(?<extractVersion>.*?))?\\n.*?(_tag|_version): '(?<currentValue>.*?)'"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-.*\\.yml/"],
      "matchStrings": [
        "version: (?<currentValue>.*?)  # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Giltfile.yaml/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n.*?version: '(?<currentValue>.*?)'"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/[^/]+\\/Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\nARG \\w*VERSION=(?<currentValue>.*?)\n"
      ]
    }
  ]
}
