{% macro q(v) %}"{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}
[Global]
auth-url={{ q(clusterapi_cluster_openstack_auth_url) }}
application-credential-id={{ q(clusterapi_cluster_openstack_application_credential_id) }}
application-credential-secret={{ q(clusterapi_cluster_openstack_application_credential_secret) }}
region={{ q(clusterapi_cluster_openstack_region_name) }}
domain-name={{ q(clusterapi_cluster_openstack_domain_name) }}
{% if clusterapi_cluster_openstack_cacert | d('') %}
ca-file=/etc/config/cacert.pem
{% endif %}

[BlockStorage]
ignore-volume-az={{ clusterapi_cluster_openstack_ignore_volume_az | bool | lower }}

{% set lb_method = clusterapi_cluster_lb_method | d('') or ('SOURCE_IP_PORT' if clusterapi_cluster_lb_provider | d('') == 'ovn' else '') %}
{% if clusterapi_cluster_lb_provider | d('') or lb_method %}
[LoadBalancer]
{% if clusterapi_cluster_lb_provider | d('') %}
lb-provider={{ q(clusterapi_cluster_lb_provider) }}
{% endif %}
{% if lb_method %}
lb-method={{ q(lb_method) }}
{% endif %}
{% if clusterapi_cluster_lb_provider | d('') == 'ovn' %}
manage-security-groups=true
{% endif %}

{% endif %}
[LoadBalancerClass "floatingPool"]
floating-network-id={{ q(clusterapi_cluster_openstack_external_network_id) }}
