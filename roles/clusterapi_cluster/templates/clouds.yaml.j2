---
clouds:
  openstack:
    auth:
      auth_url: {{ clusterapi_cluster_openstack_auth_url | to_json }}
      application_credential_id: {{ clusterapi_cluster_openstack_application_credential_id | to_json }}
      application_credential_secret: {{ clusterapi_cluster_openstack_application_credential_secret | to_json }}
    region_name: {{ clusterapi_cluster_openstack_region_name | to_json }}
    interface: "public"
    identity_api_version: 3
    auth_type: "v3applicationcredential"
{% if clusterapi_cluster_openstack_cacert | d('') %}
    cacert: /etc/certs/cacert.pem
{% endif %}
