{#- Go duration (e.g. 300s, 20m, 1h30m) or plain seconds to seconds, for the v1beta2 *Seconds fields. -#}
{%- macro _seconds(v) -%}
{%- set s = v | string -%}
{%- if s is not match('^([0-9]+[smh])+$') and s is not match('^[0-9]+$') -%}
{{ {}['invalid duration (use e.g. 300s, 20m, 1h30m or seconds): ' ~ s] }}
{%- endif -%}
{%- set t = namespace(sum=0) -%}
{%- if s is match('^[0-9]+$') -%}
{%- set t.sum = s | int -%}
{%- else -%}
{%- for n, u in s | regex_findall('([0-9]+)([smh])') -%}
{%- set t.sum = t.sum + (n | int) * {'s': 1, 'm': 60, 'h': 3600}[u] -%}
{%- endfor -%}
{%- endif -%}
{{ t.sum }}
{%- endmacro -%}
{% set ntp = clusterapi_cluster_ntp_servers | d([]) | length > 0 %}
{% set cilium = clusterapi_cluster_network == 'cilium' %}
{% set k8s_version = 'v' ~ (clusterapi_cluster_kubernetes_version | string | regex_replace('^v', '')) %}
{% set _mirrors = [
  {'host': 'docker.io', 'url': clusterapi_cluster_container_registry_cache_dockerhub},
  {'host': 'europe-docker.pkg.dev', 'url': clusterapi_cluster_container_registry_cache_pkg},
  {'host': 'gcr.io', 'url': clusterapi_cluster_container_registry_cache_gcr},
  {'host': 'ghcr.io', 'url': clusterapi_cluster_container_registry_cache_ghcr},
  {'host': 'quay.io', 'url': clusterapi_cluster_container_registry_cache_quay},
  {'host': 'registry.k8s.io', 'url': clusterapi_cluster_container_registry_cache_k8s},
] %}
{% set kct_spec %}
spec:
  template:
    spec:
      files:
{% for m in _mirrors if m.url | d('') | length > 0 %}
        - path: /etc/containerd/certs.d/{{ m.host }}/hosts.toml
          owner: root:root
          permissions: "0644"
          content: |
            server = "https://{{ m.host }}"

            [host."{{ m.url }}"]
              capabilities = ["pull", "resolve"]
              override_path = true
{% endfor %}
{% if clusterapi_cluster_openstack_cacert | d('') %}
        - path: /etc/certs/cacert.pem
          owner: root:root
          permissions: "0644"
          content: |
{{ clusterapi_cluster_openstack_cacert | indent(12, true) }}
{% endif %}
{% if clusterapi_cluster_proxy_env | d({}) | length > 0 %}
        - path: /etc/systemd/system/containerd.service.d/http-proxy.conf
          owner: root:root
          permissions: "0644"
          content: |
            [Service]
{% for key, value in clusterapi_cluster_proxy_env.items() %}
            Environment="{{ key | upper }}={{ value }}"
{% endfor %}
{% endif %}
{% if ntp %}
        - path: /etc/chrony/chrony.conf
          owner: root:root
          permissions: "0644"
          content: |
            keyfile /etc/chrony/chrony.keys
            driftfile /var/lib/chrony/chrony.drift
            ntsdumpdir /var/lib/chrony
            logdir /var/log/chrony
            maxupdateskew 100.0
            rtcsync
            makestep 1 3
{% for entry in clusterapi_cluster_ntp_servers | d([]) %}
            server {{ entry }}
{% endfor %}
{% endif %}
{% if clusterapi_cluster_hosts_entries | d([]) | length > 0 or clusterapi_cluster_proxy_env | d({}) | length > 0 or ntp %}
      preKubeadmCommands:
{% for entry in clusterapi_cluster_hosts_entries | d([]) %}
        - echo "{{ entry.ip }} {{ entry.hostname }}" >> /etc/hosts
{% endfor %}
{% if clusterapi_cluster_proxy_env | d({}) | length > 0 %}
        - systemctl daemon-reload
        - systemctl restart containerd
{% endif %}
{% if ntp %}
        - systemctl restart chrony.service
{% endif %}
{% endif %}
      joinConfiguration:
        nodeRegistration:
          kubeletExtraArgs:
          - name: cloud-provider
            value: external
          - name: provider-id
            value: openstack:///'{% raw %}{{ instance_id }}{% endraw %}'
          name: "{% raw %}{{ local_hostname }}{% endraw %}"
{% if cilium %}
          taints:
          - key: "node.cilium.io/agent-not-ready"
            value: "true"
            effect: "NoSchedule"
{% endif %}
{% endset %}
{# Content hash in the name: a changed bootstrap config rolls out to the workers like a machine template change. #}
{% set kct_name = clusterapi_cluster_name ~ '-md-' ~ (kct_spec | hash('sha1'))[:8] %}
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: {{ kct_name }}
{{ kct_spec }}---
{% set _cp_machine_template_content = {
  'flavor': clusterapi_cluster_control_plane_machine_flavor,
  'image_id': clusterapi_cluster_openstack_image_id,
  'ssh_key_name': clusterapi_cluster_openstack_ssh_key_name,
  'root_volume_enabled': clusterapi_cluster_root_volume_enabled,
  'root_volume_size': clusterapi_cluster_control_plane_root_volume_size,
  'root_volume_type': clusterapi_cluster_root_volume_type,
  'root_volume_az': clusterapi_cluster_root_volume_availability_zone,
  'server_group_id': _clusterapi_cluster_control_plane_server_group_id | d(''),
} %}
{% set cp_machine_template_name = clusterapi_cluster_name ~ '-control-plane-' ~ (_cp_machine_template_content | to_json | hash('sha1'))[:8] %}
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: {{ clusterapi_cluster_name }}
spec:
  clusterNetwork:
    pods:
      cidrBlocks: {{ clusterapi_cluster_pod_cidr_blocks | to_json }}
    serviceDomain: cluster.local
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: {{ clusterapi_cluster_name }}-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: OpenStackCluster
    name: {{ clusterapi_cluster_name }}
{% for md in clusterapi_cluster_worker_machine_deployments %}
{% set _md_machine_template_content = {
  'flavor': clusterapi_cluster_worker_machine_flavor,
  'image_id': md.image_id,
  'ssh_key_name': clusterapi_cluster_openstack_ssh_key_name,
  'root_volume_enabled': clusterapi_cluster_root_volume_enabled,
  'root_volume_size': clusterapi_cluster_worker_root_volume_size,
  'root_volume_type': clusterapi_cluster_root_volume_type,
  'root_volume_az': md.root_volume_failure_domain | d(md.failure_domain),
  'server_group_id': _clusterapi_cluster_worker_server_group_id | d(''),
} %}
{% set md_machine_template_name = clusterapi_cluster_name ~ '-' ~ md.name ~ '-' ~ (_md_machine_template_content | to_json | hash('sha1'))[:8] %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: {{ clusterapi_cluster_name }}-{{ md.name }}
spec:
  clusterName: {{ clusterapi_cluster_name }}
  replicas: {{ md.replicas }}
  selector:
    matchLabels: null
  template:
    spec:
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: {{ kct_name }}
      clusterName: {{ clusterapi_cluster_name }}
      deletion:
        nodeDrainTimeoutSeconds: {{ clusterapi_cluster_worker_node_drain_timeout_seconds }}
        nodeVolumeDetachTimeoutSeconds: {{ clusterapi_cluster_worker_node_volume_detach_timeout_seconds }}
      failureDomain: {{ md.failure_domain }}
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: {{ md_machine_template_name }}
      version: {{ k8s_version }}
{% if clusterapi_cluster_worker_machine_health_check_enabled | bool %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineHealthCheck
metadata:
  name: {{ clusterapi_cluster_name }}-{{ md.name }}-mhc
spec:
  clusterName: {{ clusterapi_cluster_name }}
  selector:
    matchLabels:
      cluster.x-k8s.io/deployment-name: {{ clusterapi_cluster_name }}-{{ md.name }}
  checks:
    nodeStartupTimeoutSeconds: {{ _seconds(clusterapi_cluster_worker_machine_health_check_node_startup_timeout) }}
    unhealthyNodeConditions:
      - type: Ready
        status: Unknown
        timeoutSeconds: {{ _seconds(clusterapi_cluster_worker_machine_health_check_unhealthy_timeout) }}
      - type: Ready
        status: "False"
        timeoutSeconds: {{ _seconds(clusterapi_cluster_worker_machine_health_check_unhealthy_timeout) }}
  remediation:
    triggerIf:
{% set _max_unhealthy = clusterapi_cluster_worker_machine_health_check_max_unhealthy | string %}
      unhealthyLessThanOrEqualTo: {{ (_max_unhealthy | int) if _max_unhealthy is match('^[0-9]+$') else (_max_unhealthy | to_json) }}
{% endif %}
{% endfor %}
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: {{ clusterapi_cluster_name }}-control-plane
spec:
  kubeadmConfigSpec:
    files:
{% if clusterapi_cluster_secrets_encryption_enabled | bool %}
      - path: /etc/kubernetes/encryption/config.yaml
        owner: root:root
        permissions: "0600"
        contentFrom:
          secret:
            name: {{ clusterapi_cluster_name }}-encryption-config
            key: config.yaml
{% endif %}
{% for m in _mirrors if m.url | d('') | length > 0 %}
      - path: /etc/containerd/certs.d/{{ m.host }}/hosts.toml
        owner: root:root
        permissions: "0644"
        content: |
          server = "https://{{ m.host }}"

          [host."{{ m.url }}"]
            capabilities = ["pull", "resolve"]
            override_path = true
{% endfor %}
{% if clusterapi_cluster_openstack_cacert | d('') %}
      - path: /etc/certs/cacert.pem
        owner: root:root
        permissions: "0644"
        content: |
{{ clusterapi_cluster_openstack_cacert | indent(10, true) }}
{% endif %}
{% if clusterapi_cluster_proxy_env | d({}) | length > 0 %}
      - path: /etc/systemd/system/containerd.service.d/http-proxy.conf
        owner: root:root
        permissions: "0644"
        content: |
          [Service]
{% for key, value in clusterapi_cluster_proxy_env.items() %}
          Environment="{{ key | upper }}={{ value }}"
{% endfor %}
{% endif %}
{% if ntp %}
      - path: /etc/chrony/chrony.conf
        owner: root:root
        permissions: "0644"
        content: |
          keyfile /etc/chrony/chrony.keys
          driftfile /var/lib/chrony/chrony.drift
          ntsdumpdir /var/lib/chrony
          logdir /var/log/chrony
          maxupdateskew 100.0
          rtcsync
          makestep 1 3
{% for entry in clusterapi_cluster_ntp_servers | d([]) %}
          server {{ entry }}
{% endfor %}
{% endif %}
{% if clusterapi_cluster_hosts_entries | d([]) | length > 0 or clusterapi_cluster_proxy_env | d({}) | length > 0 or ntp %}
    preKubeadmCommands:
{% for entry in clusterapi_cluster_hosts_entries | d([]) %}
      - echo "{{ entry.ip }} {{ entry.hostname }}" >> /etc/hosts
{% endfor %}
{% if clusterapi_cluster_proxy_env | d({}) | length > 0 %}
      - systemctl daemon-reload
      - systemctl restart containerd
{% endif %}
{% if ntp %}
      - systemctl restart chrony.service
{% endif %}
{% endif %}
    clusterConfiguration:
{% if clusterapi_cluster_secrets_encryption_enabled | bool %}
      apiServer:
        extraArgs:
        - name: encryption-provider-config
          value: /etc/kubernetes/encryption/config.yaml
        extraVolumes:
        - name: encryption-config
          hostPath: /etc/kubernetes/encryption
          mountPath: /etc/kubernetes/encryption
          readOnly: true
          pathType: DirectoryOrCreate
{% endif %}
      controllerManager:
        extraArgs:
        - name: cloud-provider
          value: external
    initConfiguration:
      nodeRegistration:
        kubeletExtraArgs:
        - name: cloud-provider
          value: external
        - name: provider-id
          value: openstack:///'{% raw %}{{ instance_id }}{% endraw %}'
        name: "{% raw %}{{ local_hostname }}{% endraw %}"
        taints:
{% if cilium %}
        - key: "node.cilium.io/agent-not-ready"
          effect: "NoSchedule"
{% endif %}
        - key: "node-role.kubernetes.io/control-plane"
          effect: "NoSchedule"
    joinConfiguration:
      nodeRegistration:
        kubeletExtraArgs:
        - name: cloud-provider
          value: external
        - name: provider-id
          value: openstack:///'{% raw %}{{ instance_id }}{% endraw %}'
        name: "{% raw %}{{ local_hostname }}{% endraw %}"
        taints:
{% if cilium %}
        - key: "node.cilium.io/agent-not-ready"
          effect: "NoSchedule"
{% endif %}
        - key: "node-role.kubernetes.io/control-plane"
          effect: "NoSchedule"
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: {{ cp_machine_template_name }}
  replicas: {{ clusterapi_cluster_control_plane_machine_count }}
  remediation:
    maxRetry: {{ clusterapi_cluster_control_plane_remediation_max_retry }}
    retryPeriodSeconds: {{ clusterapi_cluster_control_plane_remediation_retry_period_seconds }}
    minHealthyPeriodSeconds: {{ clusterapi_cluster_control_plane_remediation_min_healthy_period_seconds }}
  version: {{ k8s_version }}
{% if clusterapi_cluster_control_plane_machine_health_check_enabled | bool %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineHealthCheck
metadata:
  name: {{ clusterapi_cluster_name }}-control-plane-mhc
spec:
  clusterName: {{ clusterapi_cluster_name }}
  selector:
    matchLabels:
      cluster.x-k8s.io/control-plane: ""
  checks:
    unhealthyNodeConditions:
      - type: Ready
        status: Unknown
        timeoutSeconds: {{ _seconds(clusterapi_cluster_control_plane_machine_health_check_unhealthy_timeout) }}
      - type: Ready
        status: "False"
        timeoutSeconds: {{ _seconds(clusterapi_cluster_control_plane_machine_health_check_unhealthy_timeout) }}
{% endif %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: {{ clusterapi_cluster_name }}
spec:
  apiServer:
    managedLoadBalancer:
      enabled: true
      provider: {{ clusterapi_cluster_openstack_loadbalancer_provider }}
{% if clusterapi_cluster_openstack_loadbalancer_allowed_cidrs | d([]) | length > 0 %}
      allowedCIDRs: {{ clusterapi_cluster_openstack_loadbalancer_allowed_cidrs | to_json }}
{% endif %}
      monitor:
        delay: {{ clusterapi_cluster_openstack_loadbalancer_monitor_delay }}
        timeout: {{ clusterapi_cluster_openstack_loadbalancer_monitor_timeout }}
        maxRetries: {{ clusterapi_cluster_openstack_loadbalancer_monitor_max_retries }}
  externalNetwork:
    id: {{ clusterapi_cluster_openstack_external_network_id }}
  identityRef:
    cloudName: {{ clusterapi_cluster_openstack_cloud_name }}
    name: {{ clusterapi_cluster_name }}-cloud-config
  managedSecurityGroups:
    allowAllInClusterTraffic: True
{% if clusterapi_cluster_openstack_subnets | d([]) | length > 0 %}
  subnets:
{% for subnet in clusterapi_cluster_openstack_subnets %}
    - id: {{ subnet.id }}
{% endfor %}
{% else %}
  managedSubnets:
{% for subnet in clusterapi_cluster_openstack_managed_subnets %}
    - cidr: {{ subnet.cidr }}
{% if subnet.dns_nameservers | d([]) | length > 0 %}
      dnsNameservers:
{% for ns in subnet.dns_nameservers %}
        - {{ ns }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
  controlPlaneAvailabilityZones:
{% for az in clusterapi_cluster_openstack_availability_zones %}
    - {{ az }}
{% endfor %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: {{ cp_machine_template_name }}
spec:
  template:
    spec:
      flavor:
        filter:
          name: {{ clusterapi_cluster_control_plane_machine_flavor | to_json }}
      image:
        id: {{ clusterapi_cluster_openstack_image_id }}
      sshKeyName: {{ clusterapi_cluster_openstack_ssh_key_name }}
{% if clusterapi_cluster_control_plane_server_group_enabled | bool %}
      serverGroup:
        id: {{ _clusterapi_cluster_control_plane_server_group_id }}
{% endif %}
{% if clusterapi_cluster_root_volume_enabled | bool %}
      rootVolume:
        sizeGiB: {{ clusterapi_cluster_control_plane_root_volume_size }}
        type: {{ clusterapi_cluster_root_volume_type }}
        availabilityZone:
          name: {{ clusterapi_cluster_root_volume_availability_zone }}
{% endif %}
{% for md in clusterapi_cluster_worker_machine_deployments %}
{% set _md_machine_template_content = {
  'flavor': clusterapi_cluster_worker_machine_flavor,
  'image_id': md.image_id,
  'ssh_key_name': clusterapi_cluster_openstack_ssh_key_name,
  'root_volume_enabled': clusterapi_cluster_root_volume_enabled,
  'root_volume_size': clusterapi_cluster_worker_root_volume_size,
  'root_volume_type': clusterapi_cluster_root_volume_type,
  'root_volume_az': md.root_volume_failure_domain | d(md.failure_domain),
  'server_group_id': _clusterapi_cluster_worker_server_group_id | d(''),
} %}
{% set md_machine_template_name = clusterapi_cluster_name ~ '-' ~ md.name ~ '-' ~ (_md_machine_template_content | to_json | hash('sha1'))[:8] %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: {{ md_machine_template_name }}
spec:
  template:
    spec:
      flavor:
        filter:
          name: {{ clusterapi_cluster_worker_machine_flavor | to_json }}
      image:
        id: {{ md.image_id }}
      sshKeyName: {{ clusterapi_cluster_openstack_ssh_key_name }}
{% if clusterapi_cluster_worker_server_group_enabled | bool %}
      serverGroup:
        id: {{ _clusterapi_cluster_worker_server_group_id }}
{% endif %}
{% if clusterapi_cluster_root_volume_enabled | bool %}
      rootVolume:
        sizeGiB: {{ clusterapi_cluster_worker_root_volume_size }}
        type: {{ clusterapi_cluster_root_volume_type }}
        availabilityZone:
          name: {{ md.root_volume_failure_domain | d(md.failure_domain) }}
{% endif %}
{% endfor %}
