#!/usr/bin/env bash

# DO NOT EDIT THIS FILE BY HAND -- YOUR CHANGES WILL BE OVERWRITTEN

if [[ -t 0 ]]; then
    TTY="-it"
else
    TTY="-i"
fi

# Without arguments an interactive shell is started, in which kubectl and
# gardenlogin are available for the targeted cluster.
if [[ $# -eq 0 ]]; then
    set -- bash
else
    set -- gardenctl "$@"
fi

exec docker exec $TTY --user gardenctl \
    --env HOME=/var/lib/yake/gardenctl \
    --env GCTL_SESSION_ID="${GCTL_SESSION_ID:-yake}" \
    gardenctl "$@"
