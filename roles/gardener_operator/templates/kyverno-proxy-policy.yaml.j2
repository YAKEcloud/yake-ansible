{%- set _ns = namespace(items=[]) -%}
{%- for key, value in gardener_operator_proxy_env.items() -%}
{%- set _ns.items = _ns.items + ['Object.spec.containers.env{name:"' + key + '",value:"' + value + '"}'] -%}
{%- endfor -%}
{%- set _cel_env = '[' + (_ns.items | join(', ')) + ']' -%}
{% if gardener_operator_proxy_env | d({}) | length > 0 %}
---
apiVersion: policies.kyverno.io/v1
kind: MutatingPolicy
metadata:
  name: inject-proxy-env
spec:
  matchConstraints:
    resourceRules:
    - apiGroups: [""]
      apiVersions: ["v1"]
      resources: ["pods"]
      operations: ["CREATE"]
    namespaceSelector:
      matchLabels:
        gardener.cloud/role: extension
  mutations:
  - patchType: ApplyConfiguration
    applyConfiguration:
      expression: |
        Object{
          spec: Object.spec{
            containers: object.spec.containers.map(c, Object.spec.containers{
              name: c.name,
              env: {{ _cel_env }}
            })
          }
        }
  - patchType: ApplyConfiguration
    applyConfiguration:
      expression: |
        has(object.spec.initContainers) ?
        Object{
          spec: Object.spec{
            initContainers: object.spec.initContainers.map(ic, Object.spec.initContainers{
              name: ic.name,
              env: {{ _cel_env }}
            })
          }
        } : Object{}
{% endif %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kyverno:mutate-gardener-operatingsystemconfigs:view
  labels:
    rbac.kyverno.io/aggregate-to-background-controller: 'true'
    rbac.kyverno.io/aggregate-to-reports-controller: 'true'
rules:
  - apiGroups:
      - extensions.gardener.cloud
    resources:
      - operatingsystemconfigs
    verbs:
      - get
      - list
      - watch
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kyverno:mutate-gardener-operatingsystemconfigs:update
  labels:
    rbac.kyverno.io/aggregate-to-background-controller: 'true'
rules:
  - apiGroups:
      - extensions.gardener.cloud
    resources:
      - operatingsystemconfigs
    verbs:
      - update
---
apiVersion: policies.kyverno.io/v1
kind: MutatingPolicy
metadata:
  name: gardener-operatingsystemconfigs-inject-proxy-env
spec:
  matchConstraints:
    resourceRules:
    - apiGroups:
      - "extensions.gardener.cloud"
      apiVersions:
      - "v1alpha1"
      resources:
      - "operatingsystemconfigs"
      operations:
      - "CREATE"
      - "UPDATE"
  mutations:
{% if gardener_operator_proxy_env | d({}) | length > 0 %}
{% set proxy_dropin_name = "http-proxy.conf" %}
{% set proxy_dropin_content = '[Service]\\n'
                              + ['Environment']
                                | product(
                                  gardener_operator_proxy_env
                                  | items
                                  | map('join', '=')
                                )
                                | map('join', '=\\"')
                                | join('\\"\\n')
                              + '\\"'
%}
{% for proxy_unit_name in ["containerd.service", "gardener-node-agent.service"] %}
  - patchType: JSONPatch
    jsonPatch:
      # This expression concatenates lists of JSONPatches ([...] + [...] + [...]), where each list contains a patch on mutually exclusive conditions, so that in the end a list with a single patch is applied
      # Common patterns are:
      # condition ? patch : [], ternary conditional operator, so that a patch is returned when the condition is satisfied, otherwise an empty list
      # object.map(v, condition(v) ? patch : null ).filter(p, p!= null), map the ternary operator to a list, so that it contains either patches or null, where the latter is removed afterwards. This is used to compute the index to target the patch
      # object.map(v, condition(v) ? [patch] : []).flatten(), similar to the above, but with lists of patches and empty lists, which is later flattened. This is used to to operate on nested lists
      # The following cases are handled:
      # 1. No unit is found -> create the unit including the proxy dropIn
      # 2. A unit is found, but does not contain any dropIns -> create the dropIn list including the proxy dropIn
      # 3. A unit is found and does contain dropIns
      # 3a. dropIns does not contain the proxy -> add the proxy dropIn
      # 3b. dropIns does contain the proxy, but its contents do not match -> replace the contents
      #
      # Open questions:
      # When to use `dyn({})` and when to use the object constructor `Object{}`?
      # Why is it `dropIns: [Object.spec.units.dropIns{}]` when `Object.spec.units.dropIns` is the array of dropIns and not a dropIn object?
      #
      # I do not know the answer, but this is the version that results in the correctly patched OperatingSystemConfigs
      expression: |
        !object.spec.units.exists(u, u.name == "{{ proxy_unit_name }}") ?
          [
            JSONPatch{
              op: "add",
              path: "/spec/units/-",
              value: Object.spec.units{
                name: "{{ proxy_unit_name }}",
                dropIns: [
                  Object.spec.units.dropIns{
                    name: "{{ proxy_dropin_name }}",
                    content: "{{ proxy_dropin_content }}"
                  }
                ]
              }
            }
          ]
        : []
        +
        object.spec.units.map(u, u.name == "{{ proxy_unit_name }}" && !has(u.dropIns) ?
          JSONPatch{
            op: "add",
            path: "/spec/units/" + string(object.spec.units.indexOf(u)) + "/dropIns",
            value: [
              dyn(
                {
                  "name": "{{ proxy_dropin_name }}",
                  "content": "{{ proxy_dropin_content }}"
                }
              )
            ]
          }
        : null
        ).filter(p, p != null)
        +
        object.spec.units.map(u, u.name == "{{ proxy_unit_name }}" && has(u.dropIns) ?
          (
            !u.dropIns.exists(d, d.name == "{{ proxy_dropin_name }}") ?
              [
                JSONPatch{
                  op: "add",
                  path: "/spec/units/" + string(object.spec.units.indexOf(u)) + "/dropIns/-",
                  value: dyn(
                    {
                      "name": "{{ proxy_dropin_name }}",
                      "content": "{{ proxy_dropin_content }}"
                    }
                  )
                }
              ]
            :
              u.dropIns.map(d, d.name == "{{ proxy_dropin_name }}" && d.content != "{{ proxy_dropin_content }}" ?
                JSONPatch{
                  op: "replace",
                  path: "/spec/units/" + string(object.spec.units.indexOf(u)) + "/dropIns/" + string(object.spec.units.indexOf(d)) + "/content",
                  value: "{{ proxy_dropin_content }}"
                }
              : null
              ).filter(p, p != null)
          )
        : []
        ).flatten()
{% endfor %}
{% endif %}
{% if gardener_operator_time_source | d('') == 'kvm_ptp' %}
{% set chrony_conf = 'keyfile /etc/chrony/chrony.keys\n'
                     + 'driftfile /var/lib/chrony/chrony.drift\n'
                     + 'ntsdumpdir /var/lib/chrony\n'
                     + 'logdir /var/log/chrony\n'
                     + 'maxupdateskew 100.0\n'
                     + 'rtcsync\n'
                     + 'makestep 1 3\n'
                     + 'refclock PHC /dev/ptp_kvm poll 2 stratum 1\n' %}
{% set kvm_ptp_files = [
  {'path': '/etc/modules-load.d/ptp_kvm.conf', 'data': 'ptp_kvm\n'},
  {'path': '/etc/udev/rules.d/60-kvm-ptp.rules', 'data': 'SUBSYSTEM=="ptp", ATTR{clock_name}=="kvm-ptp", SYMLINK+="ptp_kvm", TAG+="systemd"\n'},
  {'path': '/etc/systemd/system/chrony.service.d/10-after-ptp-kvm.conf', 'data': '[Unit]\nWants=dev-ptp_kvm.device\nAfter=dev-ptp_kvm.device\n'},
  {'path': '/etc/chrony/chrony.conf', 'data': chrony_conf},
] %}
{% set kvm_ptp_unit_content = '[Unit]\n'
                              + 'Description=Install chrony for KVM PTP time sync\n'
                              + 'Wants=network-online.target\n'
                              + 'After=network-online.target\n'
                              + '[Service]\n'
                              + 'Type=oneshot\n'
                              + 'RemainAfterExit=yes\n'
                              + 'Restart=on-failure\n'
                              + 'RestartSec=30\n'
                              + 'Environment=DEBIAN_FRONTEND=noninteractive\n'
                              + 'ExecStartPre=-/usr/sbin/modprobe ptp_kvm\n'
                              + 'ExecStartPre=-/usr/bin/apt-get update -qq\n'
                              + 'ExecStart=/usr/bin/apt-get install -y -o Dpkg::Options::=--force-confold chrony\n'
                              + 'ExecStartPost=-/usr/bin/udevadm trigger --subsystem-match=ptp\n'
                              + 'ExecStartPost=-/usr/bin/udevadm settle\n'
                              + 'ExecStartPost=/usr/bin/systemctl restart chrony.service\n'
                              + '[Install]\n'
                              + 'WantedBy=multi-user.target\n' %}
  # Installs chrony from the apt mirror and syncs it against the hypervisor clock (KVM PTP).
  # The unit depends on the files via filePaths, so the gardener-node-agent re-runs it when they change.
{% for f in kvm_ptp_files %}
{% set file_json = {'path': f.path, 'permissions': 420, 'content': {'inline': {'encoding': '', 'data': f.data}}} | to_json %}
  - patchType: JSONPatch
    jsonPatch:
      expression: |
        !has(object.spec.files) ?
          [JSONPatch{op: "add", path: "/spec/files", value: [dyn({{ file_json }})]}]
        : !object.spec.files.exists(f, f.path == "{{ f.path }}") ?
          [JSONPatch{op: "add", path: "/spec/files/-", value: dyn({{ file_json }})}]
        : []
{% endfor %}
{% set unit_json = {'name': 'yake-chrony-ptp-kvm.service', 'command': 'start', 'enable': true, 'content': kvm_ptp_unit_content, 'filePaths': kvm_ptp_files | map(attribute='path') | list} | to_json %}
  - patchType: JSONPatch
    jsonPatch:
      expression: |
        !object.spec.units.exists(u, u.name == "yake-chrony-ptp-kvm.service") ?
          [JSONPatch{op: "add", path: "/spec/units/-", value: dyn({{ unit_json }})}]
        : []
{% endif %}
