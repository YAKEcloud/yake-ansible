{% for project in gardener_operator_projects %}
---
apiVersion: core.gardener.cloud/v1beta1
kind: Project
metadata:
  name: {{ project.name | to_json }}
spec:
{% if project.namespace | d('') | length > 0 %}
  namespace: {{ project.namespace | to_json }}
{% endif %}
  members:
{% for member in project.members %}
    - apiGroup: rbac.authorization.k8s.io
      kind: User
      name: {{ member.email | to_json }}
      role: {{ member.role | to_json }}
{% if member.roles | d([]) | length > 0 %}
      roles:
{% for extra_role in member.roles %}
        - {{ extra_role | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
